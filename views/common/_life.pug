section.life
  .container.life__container
    h2.life__title Несколько чисел моей жизни
    - var br = "<br/>"
    .life__slogan У музыки нет возраста и нации, !{br} однажды мы уйдём, а она останется.
    ul.life__skills
      each item in skills
        li.life__skill
          .life__skill-number= item.number
          .life__skill-text= item.text
    a(href="https://ru.wikipedia.org/wiki/%D0%A0%D0%BE%D0%BA-%D0%BC%D1%83%D0%B7%D1%8B%D0%BA%D0%B0").life__link Читать историю